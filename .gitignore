# Historical notes contain deployment/user details. Keep locally; opt in only
# reviewed, public documentation. License originals remain versionable.
/docs/**
!/docs/third-party/
!/docs/third-party/**
!/docs/source-configuration.md
!/docs/source-release-checklist.md
!/docs/quick-start.md
!/docs/building.md
!/docs/resource-audit.md
!/docs/privacy.md
!/docs/third-party-inventory.json
!/docs/source-provenance-review.md

# Configuration directory is allowlisted; real values belong outside checkout.
/config/*
!/config/public.json
!/config/*.example.json

# Reviewed README artwork only; private screenshots stay excluded.
!/docs/images/
!/docs/images/pulse-companion-catgirl.png
